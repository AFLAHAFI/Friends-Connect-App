// Friends Connect — Prisma Schema (PostgreSQL + PostGIS)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

enum UserRole {
  NORMAL
  CELEBRITY
  ORG
  SUPPORT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  RESTRICTED
  SUSPENDED
}

enum AvailabilityStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum MediaType {
  PHOTO
  VIDEO
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  REFUNDED
}

enum CallType {
  RANDOM_AUDIO
  RANDOM_VIDEO
  CELEB_AUDIO
  CELEB_VIDEO
  SUPPORT_AUDIO
}

enum CallEndReason {
  COMPLETED
  INSUFFICIENT_COINS
  REJECTED
  REPORTED
  DISCONNECTED
}

enum SupportPriority {
  NORMAL
  CELEBRITY_VIP
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  phoneNumber         String               @unique @map("phone_number")
  role                UserRole             @default(NORMAL)
  displayName         String               @map("display_name")
  avatarUrl           String?              @map("avatar_url")
  status              AccountStatus        @default(ACTIVE)
  /// Granular Super Admin restrictions, e.g. { "canRandomAudio": true, "canRandomVideo": true, "maxCallsPerDay": 50 }
  restrictions        Json                 @default("{\"canRandomAudio\": true, \"canRandomVideo\": true, \"canCallCelebrities\": true, \"maxCallsPerDay\": 100}")
  lastKnownLat        Float?               @map("last_known_lat")
  lastKnownLng        Float?               @map("last_known_lng")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  celebrityProfile    CelebrityProfile?
  organizationProfile OrganizationProfile?
  wallet              Wallet?
  initiatedCalls      CallSession[]        @relation("CallerSessions")
  receivedCalls       CallSession[]        @relation("ReceiverSessions")
  eventBookings       EventBooking[]
  openedTickets       SupportTicket[]      @relation("RequesterTickets")
  assignedTickets     SupportTicket[]      @relation("AgentTickets")

  @@map("users")
}

model CelebrityProfile {
  userId              String             @id @map("user_id") @db.Uuid
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            String
  bio                 String
  isVerified          Boolean            @default(false) @map("is_verified")
  availability        AvailabilityStatus @default(OFFLINE)
  allowAudioCalls     Boolean            @default(true) @map("allow_audio_calls")
  allowVideoCalls     Boolean            @default(true) @map("allow_video_calls")
  audioRateCoinsPerMin Int               @default(50) @map("audio_rate_coins_per_min")
  videoRateCoinsPerMin Int               @default(120) @map("video_rate_coins_per_min")
  followersCount      Int                @default(0) @map("followers_count")

  mediaItems          CelebrityMedia[]

  @@map("celebrity_profiles")
}

model CelebrityMedia {
  id           String           @id @default(uuid()) @db.Uuid
  celebrityId  String           @map("celebrity_id") @db.Uuid
  celebrity    CelebrityProfile @relation(fields: [celebrityId], references: [userId], onDelete: Cascade)
  mediaType    MediaType        @map("media_type")
  mediaUrl     String           @map("media_url")
  thumbnailUrl String?          @map("thumbnail_url")
  caption      String?
  likesCount   Int              @default(0) @map("likes_count")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("celebrity_media")
}

model OrganizationProfile {
  userId         String   @id @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String   @map("company_name")
  registrationNo String   @map("gst_or_reg_number")
  isVerified     Boolean  @default(false) @map("is_verified")
  websiteUrl     String?  @map("website_url")

  events         Event[]

  @@map("organization_profiles")
}

model Event {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  org         OrganizationProfile @relation(fields: [orgId], references: [userId], onDelete: Cascade)
  title       String
  description String
  bannerUrl   String?             @map("banner_url")
  venueName   String              @map("venue_name")
  city        String
  latitude    Float
  longitude   Float
  startTime   DateTime            @map("start_time")
  endTime     DateTime            @map("end_time")
  status      EventStatus         @default(PUBLISHED)
  createdAt   DateTime            @default(now()) @map("created_at")

  ticketTiers TicketTier[]
  bookings    EventBooking[]

  @@index([city, status])
  @@index([latitude, longitude])
  @@map("events")
}

model TicketTier {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  priceFiat     Decimal        @map("price_fiat") @db.Decimal(10, 2)
  totalCapacity Int            @map("total_capacity")
  soldCount     Int            @default(0) @map("sold_count")

  bookings      EventBooking[]

  @@map("ticket_tiers")
}

model EventBooking {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id])
  eventId           String        @map("event_id") @db.Uuid
  event             Event         @relation(fields: [eventId], references: [id])
  tierId            String        @map("tier_id") @db.Uuid
  tier              TicketTier    @relation(fields: [tierId], references: [id])
  quantity          Int
  totalPaid         Decimal       @map("total_paid") @db.Decimal(10, 2)
  paymentGatewayRef String        @map("payment_gateway_ref")
  qrCodeHash        String        @unique @map("qr_code_hash")
  status            BookingStatus @default(CONFIRMED)
  bookedAt          DateTime      @default(now()) @map("booked_at")

  @@map("event_bookings")
}

model Wallet {
  userId          String              @id @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinBalance     Int                 @default(0) @map("coin_balance")
  earnedCoins     Int                 @default(0) @map("earned_coins")
  isPremiumMember Boolean             @default(false) @map("is_premium_member")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  transactions    WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  walletId    String   @map("wallet_id") @db.Uuid
  wallet      Wallet   @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  amountCoins Int      @map("amount_coins")
  txType      String   @map("tx_type") // RECHARGE | CELEB_CALL_DEBIT | CELEB_CALL_CREDIT | PAYOUT
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model CallSession {
  id                String         @id @default(uuid()) @db.Uuid
  callType          CallType       @map("call_type")
  callerId          String         @map("caller_id") @db.Uuid
  caller            User           @relation("CallerSessions", fields: [callerId], references: [id])
  receiverId        String         @map("receiver_id") @db.Uuid
  receiver          User           @relation("ReceiverSessions", fields: [receiverId], references: [id])
  rtcRoomId         String         @map("rtc_room_id")
  startedAt         DateTime       @default(now()) @map("started_at")
  endedAt           DateTime?      @map("ended_at")
  durationSeconds   Int            @default(0) @map("duration_seconds")
  totalCoinsCharged Int            @default(0) @map("total_coins_charged")
  endReason         CallEndReason? @map("end_reason")

  @@map("call_sessions")
}

model SupportTicket {
  id              String           @id @default(uuid()) @db.Uuid
  requesterId     String           @map("requester_id") @db.Uuid
  requester       User             @relation("RequesterTickets", fields: [requesterId], references: [id])
  assignedAgentId String?          @map("assigned_agent_id") @db.Uuid
  assignedAgent   User?            @relation("AgentTickets", fields: [assignedAgentId], references: [id])
  subject         String
  priority        SupportPriority  @default(NORMAL)
  status          SupportStatus    @default(OPEN)
  createdAt       DateTime         @default(now()) @map("created_at")
  messages        SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String        @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("support_messages")
}
